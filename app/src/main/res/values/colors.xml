<?xml version="1.0" encoding="utf-8"?>
<!--
  野炊AR应用 - 2025现代配色方案（浪漫樱花风格）

  基于 Material Design 3 和 2025流行色趋势设计
  主题：浪漫樱花 - 以 #FFC1E3 为基准的温暖粉色系
  参考资源：
  - Material Design 3 官方文档
  - 2025 Pinterest Palette
-->
<resources>
    <!-- ==================================================== -->
    <!-- 封面页颜色 - 浪漫樱花主题 -->
    <!-- ==================================================== -->
    <color name="splash_background">#FFC1E3</color>      <!-- 柔粉封面背景 -->
    <color name="ic_launcher_background">#00FFFFFF</color> <!-- 启动器图标底（透明背景） -->
    <color name="title_color">#C2185B</color>             <!-- 深洋红标题 -->
    <color name="subtitle_color">#AD1457</color>          <!-- 深粉红副标题 -->
    <color name="hint_color">#C2185B</color>             <!-- 深洋红提示 -->
    <color name="version_color">#F06292</color>          <!-- 珊瑚粉版本号 -->

    <!-- ==================================================== -->
    <!-- 主界面颜色 - 浪漫樱花主题 -->
    <!-- ==================================================== -->
    <color name="main_background">#FCE4EC</color>         <!-- 极浅粉背景 -->
    <color name="text_primary">#880E4F</color>           <!-- 深粉红主要文字 -->
    <color name="text_secondary">#AD1457</color>         <!-- 中等粉红次要文字 -->

    <!-- ==================================================== -->
    <!-- Material Design 3 基础颜色 -->
    <!-- ==================================================== -->
    <color name="purple_200">#F8BBD0</color>             <!-- 浅粉紫 -->
    <color name="purple_500">#E91E63</color>             <!-- 主粉红 -->
    <color name="purple_700">#C2185B</color>             <!-- 深粉红 -->
    <color name="teal_200">#F48FB1</color>               <!-- 浅粉红 -->
    <color name="teal_700">#EC407A</color>               <!-- 中等粉红 -->
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- ==================================================== -->
    <!-- 野炊主题颜色 - 浪漫樱花主题 -->
    <!-- ==================================================== -->
    <!-- 主色系 - 樱花粉色系 -->
    <color name="fire_red">#E91E63</color>               <!-- 深粉红（注意/SOS按钮） -->
    <color name="fire_orange">#C2185B</color>            <!-- 深洋红（主操作） -->
    <color name="fire_yellow">#F06292</color>            <!-- 珊瑚粉（明亮） -->
    <color name="fire_coral">#EC407A</color>             <!-- 粉红（强调） -->

    <!-- 自然色系 - 樱花花园 -->
    <color name="nature_green">#C2185B</color>           <!-- 深洋红（成功/主色） -->
    <color name="nature_forest">#880E4F</color>          <!-- 深粉红（深色） -->
    <color name="nature_sage">#F06292</color>            <!-- 珊瑚粉（浅色） -->
    <color name="nature_green_alpha">#FCE4EC</color>    <!-- 极浅粉半透明背景 -->
    <color name="nature_green_dark">#880E4F</color>      <!-- 深粉红文字 -->

    <!-- Material Design 3 标准色 -->
    <color name="material_green_500">#E91E63</color>    <!-- MD3 粉红500 -->
    <color name="material_orange_500">#FF9800</color>   <!-- MD3 橙色500（保持） -->

    <!-- 大地色系 - 樱花大地 -->
    <color name="wood_brown">#C2185B</color>             <!-- 深洋红 -->
    <color name="earth_sand">#F06292</color>             <!-- 珊瑚粉 -->
    <color name="earth_clay">#AD1457</color>             <!-- 中等粉红 -->
    <color name="fire_orange_alpha">#FCE4EC</color>     <!-- 极浅粉半透明背景 -->
    <color name="fire_orange_dark">#880E4F</color>       <!-- 深粉红文字 -->

    <!-- 水色系 -->
    <color name="water_lake">#F8BBD0</color>             <!-- 浅粉红 -->
    <color name="water_sky">#F48FB1</color>              <!-- 蜜桃粉 -->

    <!-- ==================================================== -->
    <!-- 视频页颜色 - 浪漫樱花风格 -->
    <!-- ==================================================== -->
    <color name="video_item_selected">#FCE4EC</color>   <!-- 极浅粉选择 -->
    <color name="button_text_color">#FFFFFF</color>
    <color name="button_background_color">#C2185B</color> <!-- 深洋红主按钮背景 -->

    <!-- ==================================================== -->
    <!-- 功能色 - 浪漫樱花版本 -->
    <!-- ==================================================== -->
    <color name="success">#C2185B</color>                <!-- 成功 - 深洋红 -->
    <color name="warning">#F06292</color>                <!-- 警告 - 珊瑚粉 -->
    <color name="error">#E91E63</color>                  <!-- 错误 - 深粉红 -->
    <color name="info">#F06292</color>                   <!-- 信息 - 珊瑚粉 -->

    <!-- ==================================================== -->
    <!-- 卡片和表面颜色 - 浪漫樱花 -->
    <!-- ==================================================== -->
    <color name="surface">#FFFFFF</color>                <!-- 白色表面 -->
    <color name="surface_variant">#FCE4EC</color>        <!-- 极浅粉表面 -->
    <color name="background">#FCE4EC</color>             <!-- 极浅粉主背景 -->

    <!-- ==================================================== -->
    <!-- 团队分工小组颜色 -->
    <!-- ==================================================== -->
    <color name="group_leader_color">#FFB300</color>        <!-- 项目组长 - 金色 -->
    <color name="group_leader_light">#FFF3E0</color>       <!-- 项目组长 - 浅金色背景 -->
    <color name="group_cooking_color">#E91E63</color>      <!-- 烹饪组 - 粉红色 -->
    <color name="group_cooking_light">#FCE4EC</color>       <!-- 烹饪组 - 浅粉红背景 -->
    <color name="group_soup_rice_color">#4FC3F7</color>     <!-- 汤饭组 - 湖水蓝 -->
    <color name="group_soup_rice_light">#E1F5FE</color>     <!-- 汤饭组 - 浅蓝色背景 -->
    <color name="group_fire_color">#FF6B35</color>          <!-- 生火组 - 火橙色 -->
    <color name="group_fire_light">#FFF3E0</color>          <!-- 生火组 - 浅橙色背景 -->
    <color name="group_health_color">#4CAF50</color>        <!-- 卫生组 - 绿色 -->
    <color name="group_health_light">#E8F5E9</color>         <!-- 卫生组 - 浅绿色背景 -->

</resources>

