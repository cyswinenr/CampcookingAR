<?xml version="1.0" encoding="utf-8"?>
<!-- 课后总结页面 - 横屏布局 -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_background"
    tools:context=".SummaryActivity">

    <!-- 顶部栏 -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:orientation="horizontal"
        android:background="@color/fire_orange"
        android:gravity="center_vertical"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 返回按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/backButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="返回"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            app:icon="@android:drawable/ic_menu_revert"
            app:iconTint="@android:color/white"
            app:iconPadding="8dp"
            android:layout_marginEnd="20dp" />

        <TextView
            android:id="@+id/teamNameText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="野炊小组"
            android:textColor="@android:color/white"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="课后总结"
            android:textColor="@android:color/white"
            android:textSize="24sp" />

    </LinearLayout>

    <!-- 内容区域 - 可滚动 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- 提示信息卡片 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#E8F5E9"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💡 提示"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#2E7D32"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="请认真思考并回答以下问题，总结本次野炊活动的收获和感悟。"
                        android:textSize="16sp"
                        android:textColor="#424242"
                        android:lineSpacingMultiplier="1.2" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- 问题1卡片 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@android:color/white"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- 问题标题 -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="问题一"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/fire_orange"
                        android:layout_marginBottom="12dp" />

                    <!-- 问题内容 -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text='单朵木棉或许单薄，但千枝万朵便能染红整座英雄城。野炊是一项复杂的工程，没有完美的个人，只有无坚不摧的团队。\n\n红棉宣言：请以"木棉"为灵感，为小组起一个专属的队名，并写下一句能代表团队精气神的"红棉宣言"。\n\n元素运用：请具体介绍一下，同学们是如何巧妙运用"木棉花"元素的？'
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:lineSpacingMultiplier="1.3"
                        android:layout_marginBottom="16dp" />

                    <!-- 输入框 -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="请输入您的回答..."
                        app:boxBackgroundMode="outline"
                        app:hintTextColor="@color/subtitle_color"
                        app:boxStrokeColor="@color/fire_orange"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/answer1Input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="200dp"
                            android:gravity="top|start"
                            android:inputType="textMultiLine|textCapSentences"
                            android:maxLines="10"
                            android:scrollbars="vertical"
                            android:textSize="18sp"
                            android:textColor="@color/text_primary"
                            android:padding="16dp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- 图片区域 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="16dp">

                        <!-- 图片区域标题 -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📷 相关图片（可选）"
                            android:textSize="16sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginBottom="8dp" />

                        <!-- 图片网格 -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/photosRecyclerView1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:scrollbars="horizontal" />

                        <!-- 添加图片按钮 -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/addPhotoButton1"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="➕ 添加图片"
                            android:textSize="16sp"
                            app:icon="@android:drawable/ic_menu_camera"
                            app:iconSize="20dp"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- 问题2卡片 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@android:color/white"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- 问题标题 -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="问题二"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/fire_orange"
                        android:layout_marginBottom="12dp" />

                    <!-- 问题内容 -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text='木棉花在枝头热烈怒放时惹人"仰望"，落入锅中熬成靓汤时又懂得"俯身"。这不仅是自然规律，更向我们展示了英雄精神的两种姿态。\n\n英雄再定义：结合今天同学们的真实体验，你对"英雄"二字有了哪些新的理解？\n\n青年担当：作为"英雄城"的新时代青年，我们该如何像这朵木棉花一样——既保持向上攀登、绽放自我的勇气，又拥有一份默默奉献、托举他人的温情？'
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:lineSpacingMultiplier="1.3"
                        android:layout_marginBottom="16dp" />

                    <!-- 输入框 -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="请输入您的回答..."
                        app:boxBackgroundMode="outline"
                        app:hintTextColor="@color/subtitle_color"
                        app:boxStrokeColor="@color/fire_orange"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/answer2Input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="200dp"
                            android:gravity="top|start"
                            android:inputType="textMultiLine|textCapSentences"
                            android:maxLines="10"
                            android:scrollbars="vertical"
                            android:textSize="18sp"
                            android:textColor="@color/text_primary"
                            android:padding="16dp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- 图片区域 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="16dp">

                        <!-- 图片区域标题 -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📷 相关图片（可选）"
                            android:textSize="16sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginBottom="8dp" />

                        <!-- 图片网格 -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/photosRecyclerView2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:scrollbars="horizontal" />

                        <!-- 添加图片按钮 -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/addPhotoButton2"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="➕ 添加图片"
                            android:textSize="16sp"
                            app:icon="@android:drawable/ic_menu_camera"
                            app:iconSize="20dp"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- 问题3卡片 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@android:color/white"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- 问题标题 -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="问题三"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/fire_orange"
                        android:layout_marginBottom="12dp" />

                    <!-- 问题内容 -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="课程中哪个瞬间让你们觉得&quot;劳动产生了美&quot;？是默契配合，还是课程开展的秩序感？请简述感动的人和事。"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:lineSpacingMultiplier="1.3"
                        android:layout_marginBottom="16dp" />

                    <!-- 输入框 -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="请输入您的回答..."
                        app:boxBackgroundMode="outline"
                        app:hintTextColor="@color/subtitle_color"
                        app:boxStrokeColor="@color/fire_orange"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/answer3Input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="200dp"
                            android:gravity="top|start"
                            android:inputType="textMultiLine|textCapSentences"
                            android:maxLines="10"
                            android:scrollbars="vertical"
                            android:textSize="18sp"
                            android:textColor="@color/text_primary"
                            android:padding="16dp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- 图片区域 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="16dp">

                        <!-- 图片区域标题 -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📷 相关图片（可选）"
                            android:textSize="16sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginBottom="8dp" />

                        <!-- 图片网格 -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/photosRecyclerView3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:scrollbars="horizontal" />

                        <!-- 添加图片按钮 -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/addPhotoButton3"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="➕ 添加图片"
                            android:textSize="16sp"
                            app:icon="@android:drawable/ic_menu_camera"
                            app:iconSize="20dp"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

    <!-- 底部保存按钮栏 -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:orientation="horizontal"
        android:background="@color/fire_orange"
        android:gravity="center_vertical|end"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveButton"
            style="@style/Widget.Material3.Button.ElevatedButton"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:text="保存总结"
            android:textSize="18sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:backgroundTint="@android:color/white"
            app:icon="@android:drawable/ic_menu_save"
            app:iconTint="@color/fire_orange"
            app:iconSize="24dp"
            app:iconPadding="8dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

